# Copy to .env.local for local dev. On Vercel, add these in Project → Settings → Environment Variables.

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Domain guests' invites live under. Each event is served at {slug}.{this}.
# Local: localhost:3000  (Chrome/Edge resolve meera-arjun.localhost:3000 automatically)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Where the dashboard lives. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Product name shown in the dashboard
NEXT_PUBLIC_APP_NAME=Mandapam

# Show the "Continue with Google" button only after Google sign-in is switched on in Supabase (Authentication > Providers).
NEXT_PUBLIC_GOOGLE_AUTH=0

# Shown on the Privacy page as the address for deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=
